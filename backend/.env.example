# Gram Vikas Backend Configuration

# Server
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL 15+); set local credentials below
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gram_vikas_db
DB_USER=YOUR_LOCAL_POSTGRES_USER
DB_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Authentication & Security (local development values only)
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_16_CHARS
JWT_EXPIRES_IN=24h

# Multi-Tenancy
DEFAULT_PANCHAYAT_ID=a0000000-0000-0000-0000-000000000001
